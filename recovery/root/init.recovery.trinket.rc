on early-init
    # 修复USB设备节点
    mkdir /dev/kmsg 0660 root system
    symlink /dev/kmsg /proc/kmsg

on init
    # 启动recovery服务
    start recovery

on boot
    # 设置基本属性
    setprop ro.boot.selinux enforcing
    setprop sys.usb.configfs 1
    setprop sys.usb.state mtp
    
    # 修复触摸屏方向
    setprop ro.treble.enabled true

# TWRP服务定义
service recovery /sbin/recovery
    class main
    user root
    group root
    disabled
    oneshot

# 设置recovery环境变量
on property:sys.boot_completed=1
    setprop ro.recovery.config true

# 服务定义用于启动adbd
service adbd /system/bin/adbd
    class main
    user shell
    group shell adb
    socket adbd stream 0660 shell shell
    disabled
    oneshot

# 启动adbd服务
on property:sys.boot_completed=1
    start adbd

# fastbootd服务定义
service fastbootd /system/bin/fastbootd
    class main
    user root
    group root
    capabilities CAP_NET_BIND_SERVICE
    disabled
    oneshot
    seclabel u:r:fastboot:s0

# 启动fastbootd服务
on property:sys.boot_completed=1
    start fastbootd